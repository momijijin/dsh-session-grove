{
  "name": "dsh-session-groups",
  "version": "0.3.0-beta.15",
  "description": "DSH left-sidebar global session groups: organize sessions across workspaces without moving them.",
  "author": "momiji-gz302ea <2648863351@qq.com>",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session-groups",
    "sidebar"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "locale",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/ARCHITECTURE.md",
    "docs/RELEASE.md",
    "docs/TEST-RESULTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:core": "node --test \"tests/core/**/*.test.js\"",
    "test:isolated": "node e2e/isolated.spec.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check": "node --check src/index.js && node --check src/shared/model.js && node --check src/client/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}








