{
  "name": "dsh-session-grove",
  "version": "0.4.0-beta.44",
  "description": "A free-form grouping layer for the DSH Desktop sidebar: assign sessions from different workspaces to the same group without changing their official workspace membership or logs.",
  "icon": "assets/icon-180.png",
  "author": "momiji-gz302ea <2648863351@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momijijin/dsh-session-grove.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session-groups",
    "session-grove",
    "sidebar"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "locale",
    "assets/icon-180.png",
    "scripts/session-grove-control.mjs",
    "skills",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/ARCHITECTURE.md",
    "docs/COMPATIBILITY.md",
    "docs/INDEX.md",
    "docs/RELEASE.md",
    "docs/TEST-RESULTS.md",
    "docs/TEST-MATRIX.md",
    "docs/I18N.md",
    "docs/MIGRATION-0.4.md",
    "docs/CONTRACTS.md",
    "docs/BACKLOG.md",
    "docs/archive/README.md",
    "docs/adr",
    "docs/release-notes"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:core": "node --test \"tests/core/**/*.test.js\"",
    "check:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=92 --test-coverage-branches=80 --test-coverage-functions=85 --test \"tests/**/*.test.js\"",
    "test:isolated": "node e2e/isolated.spec.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check": "node --check src/index.js && node --check src/shared/model.js && node --check src/client/index.js",
    "test:locale-pack": "node e2e/locale-pack.spec.mjs",
    "test:all-locales": "node e2e/all-locales.spec.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1"
  },
  "license": "MIT"
}
