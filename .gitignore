docs/specs/
docs/superpowers/
.superpowers/

# Lockfiles: package-lock.json (npm) is the release/CI install source of truth and stays tracked.
# pnpm-lock.yaml / pnpm-workspace.yaml are local-development only and are never tracked.
pnpm-lock.yaml
pnpm-workspace.yaml

# OS
Thumbs.db
.DS_Store

# Release artifacts
*.tgz
SHA256SUMS
*.sha256
# Local packaging must write into a temp directory, e.g.
#   npm pack --pack-destination "$env:TEMP\dsh-grove-pack"
# A tarball left in the repo root is a historical leftover and is never tracked.

# Local Gate 0 spike packages/reports (summarized in docs/GATE0-SUMMARY.md)
spike/
scripts/spike/

# Local visual-review screenshots (not shipped)
qa-artifacts/
